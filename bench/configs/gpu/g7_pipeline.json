{
  "name": "g7_pipeline",
  "title": "E9d: potok strumieniowy vs jeden transfer",
  "dataset": {
    "size": "1G"
  },
  "runs": [
    {
      "impl": "cuda",
      "label": "cuda",
      "args": {
        "kernel": "smem-root"
      }
    },
    {
      "impl": "cuda",
      "label": "cuda-pipeline",
      "args": {
        "kernel": "smem-root",
        "streams": [
          1,
          2,
          4,
          8
        ],
        "chunk": [
          "4M",
          "16M",
          "64M"
        ]
      }
    }
  ]
}
